# Copy to .env for local runs (`set -a; source .env; set +a`). In CI these are repo secrets.
# LLM: repo secret GEMINI_API is mapped to GEMINI_API_KEY in the workflow
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # only if llm.provider = "claude"

# Email — repo secrets EMAIL (used as SMTP_USER and EMAIL_TO) and APP_PW (SMTP_APP_PASSWORD)
# (Gmail: enable 2FA, then create an app password at https://myaccount.google.com/apppasswords)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
EMAIL_TO=you@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Telegram: create a bot with @BotFather; get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: official Azure TTS (set audio.provider = "azure" in config.toml)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Only needed to run `vocab release` locally (CI provides these automatically)
GITHUB_REPOSITORY=owner/hungarian-vocab
GITHUB_TOKEN=
